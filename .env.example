# ==============================================================================
# Enterprise PMS - Production Environment Configuration Template (.env.example)
# ==============================================================================
# All variables must be configured before deploying to Vercel and connecting to Supabase.
# DO NOT commit production secrets (.env.local) to source control.

# ==============================================================================
# 1. APPLICATION & DOMAIN CONFIGURATION
# ==============================================================================
# Public production URL of the PMS deployment
NEXT_PUBLIC_APP_URL=https://pms.jyotirmoyb.com

# Root domain used for multi-tenant subdomain resolution (e.g. acme.pms.jyotirmoyb.com)
NEXT_PUBLIC_ROOT_DOMAIN=pms.jyotirmoyb.com

# Environment execution mode: development | staging | production
NODE_ENV=production

# Application logging level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ==============================================================================
# 2. SUPABASE (POSTGRESQL & AUTH) CONFIGURATION
# ==============================================================================
# Supabase Project URL (Found under Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (Client-side safe, strictly respects RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret Key (Server-only, bypasses RLS - PROTECT CAREFULLY)
# Required for SuperAdmin operations, tenant provisioning, and automated cron workers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct PostgreSQL connection string for database migrations & Prisma/Drizzle (Port 5432)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Pooled PostgreSQL connection string via Supabase PgBouncer / Supavisor (Port 6543)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ==============================================================================
# 3. TRANSACTIONAL EMAIL INFRASTRUCTURE
# ==============================================================================
# Email delivery provider: resend | smtp | mock
EMAIL_PROVIDER=resend

# Standard sender address displayed to recipients
EMAIL_FROM=Enterprise PMS <notifications@jyotirmoyb.com>

# Resend API Key (Obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# --- SMTP Fallback Configuration (Used when EMAIL_PROVIDER=smtp) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key_here

# ==============================================================================
# 4. BACKGROUND JOBS & CRON WORKERS
# ==============================================================================
# Shared secret for authenticating Vercel Cron jobs and scheduled API webhooks.
# Must match the Authorization: Bearer <CRON_SECRET> header dispatched by Vercel.
CRON_SECRET=super-secure-randomly-generated-cron-secret-32-chars-min

# ==============================================================================
# 5. STORAGE & ASSET MANAGEMENT
# ==============================================================================
# Default public Supabase Storage bucket for project attachments and tenant logos
SUPABASE_STORAGE_BUCKET=pms-attachments

# Maximum allowed file upload size in megabytes
MAX_FILE_SIZE_MB=25

# ==============================================================================
# 6. ROOT SUPERADMIN REFERENCE CREDENTIALS (SEEDED IN MIGRATION 00009)
# ==============================================================================
# Initial Root SuperAdmin Account:
# Email: admin@jyotirmoyb.com
# Full Name: System Administrator
# Flag: is_superadmin = true
# Default Primary Tenant: Enterprise Core (Code: CORE-SYS, Slug: core)
